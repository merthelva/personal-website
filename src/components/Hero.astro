---
---

<section class="hero" id="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-label">Senior Frontend Developer</span>
      <h1 class="hero-name">Mert Helvacı</h1>
      <p class="hero-tagline">
        Building interfaces for products people use every day.<span
          class="cursor" aria-hidden="true">_</span
        >
      </p>
      <div class="hero-cta">
        <a
          href="/cv/MERT HELVACI COVER LETTER & CV.pdf"
          download
          class="btn-primary"
          aria-label="Download Mert Helvaci's CV"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download CV
        </a>
        <a
          href="https://github.com/merthelva"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          aria-label="View GitHub profile (opens in new tab)"
        >
          View GitHub
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7 7 17 7 17 17"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/mert-helvac%C4%B1-599557111"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          aria-label="View LinkedIn profile (opens in new tab)"
        >
          View LinkedIn
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7 7 17 7 17 17"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    height: 100svh;
    display: flex;
    align-items: center;
  }

  .hero-inner {
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 700px;
  }

  .hero-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-name {
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.0;
    color: var(--text-primary);
  }

  .hero-tagline {
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .cursor {
    font-weight: 300;
    color: var(--accent);
    animation: blink 0.7s step-end infinite;
    margin-left: 1px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--surface);
    background-color: var(--text-primary);
    border: 1px solid var(--text-primary);
    border-radius: 6px;
    transition:
      background-color var(--transition-mid),
      border-color var(--transition-mid),
      color var(--transition-mid);
  }

  .btn-primary:hover {
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 400;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .btn-ghost:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .hero {
      height: 100svh;
      align-items: center;
    }
  }
</style>
