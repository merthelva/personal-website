---
const stats = [
  { value: "6+", label: "Years experience" },
  { value: "5", label: "Companies" },
  { value: "CKAD", label: "Certified, April 2026" },
];
---

<section class="about" id="about">
  <div class="container">
    <span class="section-label reveal">About</span>

    <div class="about-content">
      <p>
        Senior Frontend Developer with 6+ years of experience building high-traffic financial,
        e-commerce and enterprise applications with React, TypeScript and Next.js (App Router).
        I have led frontend squads, designed scalable architectures with Redux Toolkit and
        RTK Query, and backed them with automated testing using Jest and React Testing Library.
        I also care about semantic markup, accessibility and responsive interfaces.
      </p>
      <p>
        Lately I have focused on AI-driven developer workflows: building Design2Code, an
        internal product that turns Figma designs into production-ready React and React Native
        code using custom MCP tools and multi-agent workflows on Eclipse LMOS.
        On the delivery side, I hold the Certified Kubernetes Application Developer (CKAD)
        credential and work with Docker and CI/CD pipelines. I also hold a BSc in Mechanical
        Engineering from Bilkent University.
      </p>
    </div>

    <div class="stats reveal">
      {
        stats.map((stat) => (
          <div class="stat">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <hr class="divider reveal" />

    <p class="codepen-line reveal">
      Also on{" "}
      <a
        href="https://codepen.io/helvaci-mert"
        target="_blank"
        rel="noopener noreferrer"
        class="codepen-link"
        aria-label="View CodePen profile (opens in new tab)"
      >
        CodePen
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="7" y1="17" x2="17" y2="7"/>
          <polyline points="7 7 17 7 17 17"/>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .about {
    padding: var(--section-padding) 0;
  }

  .about-content {
    display: grid;
    gap: 48px;
    padding: calc(var(--section-padding) / 2) 0;
    padding-block-start: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 64px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-value {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin-bottom: 32px;
  }

  .codepen-line {
    font-size: 13px;
    color: var(--text-muted);
  }

  .codepen-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    font-weight: 500;
  }

  .codepen-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .about {
      padding: var(--section-padding-mobile) 0;
    }

    .stats {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
