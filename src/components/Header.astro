---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <a href="#hero" aria-label="Back to top">
      <img class="avatar" src="/avatar.jpeg" />
    </a>

    <nav class="nav" id="site-nav" aria-label="Main navigation">
      <a href="#about" class="nav-link">About</a>
      <a href="#experience" class="nav-link">Experience</a>
      <a href="#skills" class="nav-link">Skills</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button
        class="hamburger"
        id="hamburger"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay nav -->
<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true">
  <nav class="mobile-nav" aria-label="Mobile navigation">
    <a href="#about" class="mobile-nav-link">About</a>
    <a href="#experience" class="mobile-nav-link">Experience</a>
    <a href="#skills" class="mobile-nav-link">Skills</a>
    <a href="#contact" class="mobile-nav-link">Contact</a>
  </nav>
</div>

<script>
  const header = document.getElementById("site-header")!;
  const hamburger = document.getElementById("hamburger")!;
  const overlay = document.getElementById("mobile-overlay")!;
  const mobileLinks = overlay.querySelectorAll(".mobile-nav-link");

  // Header scroll behavior
  let isScrolled = false;
  window.addEventListener("scroll", () => {
    const shouldScroll = window.scrollY > 60;
    if (shouldScroll !== isScrolled) {
      isScrolled = shouldScroll;
      header.classList.toggle("scrolled", isScrolled);
    }
  });

  // Mobile nav toggle
  function closeOverlay() {
    overlay.classList.remove("open");
    overlay.setAttribute("aria-hidden", "true");
    hamburger.setAttribute("aria-expanded", "false");
    hamburger.classList.remove("active");
    document.body.style.overflow = "";
  }

  hamburger.addEventListener("click", () => {
    const isOpen = overlay.classList.contains("open");
    if (isOpen) {
      closeOverlay();
    } else {
      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
      hamburger.setAttribute("aria-expanded", "true");
      hamburger.classList.add("active");
      document.body.style.overflow = "hidden";
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeOverlay);
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 0;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--transition-mid),
      border-color var(--transition-mid),
      padding var(--transition-mid);
  }

  .header.scrolled {
    background-color: var(--bg);
    border-bottom-color: var(--border);
    padding: 14px 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  
  .avatar {
    width: 32px;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-secondary);
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--accent);
    transition: width var(--transition-mid);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    color: var(--text-secondary);
    border-radius: 6px;
    transition: background-color var(--transition-fast);
  }

  .hamburger:hover {
    background-color: var(--border);
  }

  .bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: currentColor;
    transition: transform var(--transition-mid), opacity var(--transition-mid);
    transform-origin: center;
  }

  .hamburger.active .bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .hamburger.active .bar:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active .bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Mobile overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    background-color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-mid);
  }

  .mobile-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .mobile-nav-link {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    transition: color var(--transition-fast);
  }

  .mobile-nav-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .nav {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>
