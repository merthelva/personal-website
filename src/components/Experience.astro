---
const jobs = [
  {
    period: "Feb 2024 – Nov 2026",
    company: "Eteration",
    title: "Senior Frontend Developer",
    bullets: [
      "Built Design2Code, an AI-powered internal product converting Figma designs into production-ready React code via custom MCP tools, enforcing preset code conventions and best practices",
      "Led the frontend team for Garanti BBVA TAMI Dijital Para, directing architectural decisions, code reviews and feature delivery",
      "Architected the Garanti BBVA e-Trader web application with Next.js (App Router), optimizing server-side rendering and client bundle size",
      "Wrote unit tests with React Testing Library and Jest",
    ],
  },
  {
    period: "Jul 2023 – Feb 2024",
    company: "Warpiris",
    title: "Frontend Developer",
    bullets: [
      "Engineered core UI modules for the high-volume Papara web application using React and TypeScript",
      "Worked with UX/UI and backend teams to integrate secure API endpoints and optimize rendering performance",
    ],
  },
  {
    period: "Jul 2022 – May 2023",
    company: "Evreka Software",
    title: "Frontend Developer",
    bullets: [
      "Implemented UI designs for waste management platforms with React, TypeScript and styled-components",
      "Designed state management with Redux Toolkit and RTK Query, reducing redundant network payloads",
      "Documented UI components and isolated them with Storybook",
      "Built real-time asset tracking map layers with LeafletJS",
      "Authored unit test suites for UI components",
    ],
  },
  {
    period: "Nov 2021 – Jun 2022",
    company: "Getir",
    title: "Frontend Developer",
    bullets: [
      "Developed customer-facing features for the Getir Büyük and Getir Çarşı web platforms",
      "Managed async side effects and state scaling with Redux and Redux Saga",
    ],
  },
  {
    period: "Jul 2020 – Oct 2021",
    company: "SIMDATIX",
    title: "Frontend Developer",
    bullets: [
      "Built the Roadjet GmbH logistics web portal from scratch with ReactJS and Bootstrap, fully responsive and multilingual",
    ],
  },
];
---

<section class="experience" id="experience">
  <div class="container">
    <span class="section-label reveal">Experience</span>

    <div class="job-list">
      {
        jobs.map((job, i) => (
          <article class="job reveal" style={`transition-delay: ${i * 60}ms`}>
            <div class="job-meta">
              <time class="job-period">{job.period}</time>
            </div>
            <div class="job-body">
              <div class="job-header">
                <span class="job-company">{job.company}</span>
                <span class="job-title">{job.title}</span>
              </div>
              <ul class="job-bullets">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience {
    padding: var(--section-padding) 0;
    border-top: 1px solid var(--border);
  }

  .job-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .job {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid var(--border);
  }

  .job:first-of-type {
    border-top: 1px solid var(--border);
  }

  .job-meta {
    padding-top: 3px;
  }

  .job-period {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .job-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 16px;
  }

  .job-company {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: inline-block;
    position: relative;
    width: fit-content;
    cursor: default;
  }

  .job-company::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--accent);
    transition: width var(--transition-mid);
  }

  .job:hover .job-company::after {
    width: 100%;
  }

  .job-title {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .job-bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .job-bullets li {
    font-size: 15px;
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.6;
    padding-left: 16px;
    position: relative;
  }

  .job-bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--text-muted);
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .experience {
      padding: var(--section-padding-mobile) 0;
    }

    .job {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 28px 0;
    }
  }
</style>
